/**
 * 部署前把下面三个占位符换成你自己的 Cloudflare 资源 ID：
 *
 *   npx wrangler d1 create cwd-db
 *   npx wrangler kv namespace create CWD_AUTH_KV
 *   npx wrangler kv namespace create CWD_AUTH_KV --preview
 *
 * 不配置 routes 时，Worker 会使用 https://cwd-api.<你的子域>.workers.dev。
 * 想用 comments.uuu.re，需要先把 uuu.re 接入 Cloudflare，再加 routes。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cwd-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "CWD_DB",
      "database_name": "cwd-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CWD_AUTH_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_YOUR_KV_PREVIEW_ID"
    }
  ]
}
