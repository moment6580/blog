/**
 * 部署前把下面三个占位符换成你自己的 Cloudflare 资源 ID：
 *
 *   npx wrangler d1 create cwd_db
 *   npx wrangler kv namespace create CWD_AUTH_KV
 *   npx wrangler kv namespace create CWD_AUTH_KV --preview
 *
 * 不配置 routes 时，Worker 会使用 https://cwd-api.<你的子域>.workers.dev。
 * 想用 comments.uuu.re，需要先把 uuu.re 接入 Cloudflare，再加 routes。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cwd-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "CWD_DB",
      "database_name": "cwd_db",
      "database_id": "B8940625e-1c79-4884-8d06-e915e86f435f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CWD_AUTH_KV",
      "id": "0390082b0daa4049a6802c3401c5b251",
      "preview_id": "11dd6c1eeaec4e43be7977c38788acee"
    }
  ]
}
